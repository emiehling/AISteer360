{
  "name": "@aisteer360/pipeline-canvas",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "React Flow canvas for the AISteer360 pipeline workbench. Builds an IIFE bundle into ../static/canvas/ that the workbench's index.html loads.",
